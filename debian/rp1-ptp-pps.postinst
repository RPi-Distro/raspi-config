#!/bin/sh
set -e

# Remove bytecode generated by earlier package versions during an upgrade.
case "$1" in
    configure)
        for cache in /usr/libexec/rp1-ptp-pps/__pycache__/*.pyc; do
            [ -e "$cache" ] || continue
            rm -f -- "$cache"
        done
        rmdir /usr/libexec/rp1-ptp-pps/__pycache__ 2>/dev/null || true
        ;;
esac

#DEBHELPER#
